 /// The root's node: the last chunk's (or the top two values' parent),
 /// folded into the stack's values from the top.
 pub fn final_node<H: Hooks>(k: &Kernels<'_, H>, chunk: &ChunkState, stack: &CvStack) -> Output {
     if stack.len() == 0 {
         return chunk.output();
     }
