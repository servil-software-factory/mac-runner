 /// Add a whole piece. The same fold serves slice pieces and rooms.
 fn push_piece(tree: &TreeHasher, stack: &mut [Cv], used: &mut usize, preceding: u64, piece: Cv) {
     let n = merge_pieces(tree, stack, *used, preceding);
     stack[n] = piece;
     *used = n + 1;
 }
