 }
 
 /// The place of the parent of the whole subtree at `place` (an even index).
 const fn parent_place(place: u64) -> u64 {
     (place & !INDEX_MASK) + (1 << LEVEL_SHIFT) + ((place & INDEX_MASK) >> 1)
 }
 


