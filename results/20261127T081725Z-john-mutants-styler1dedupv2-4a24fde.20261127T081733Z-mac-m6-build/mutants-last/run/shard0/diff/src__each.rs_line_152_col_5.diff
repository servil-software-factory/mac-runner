 #[inline]
 pub(crate) fn finalize_indices_serial(hashers: &mut [Hasher], w_chunk: &[usize], slots: &[u8], o_chunk: &mut [[u8; OUT_LEN]]) {
     for &k in slots {
         let k = usize::from(k);
         o_chunk[k] = *hashers[w_chunk[k]].take_root_hash().as_bytes();
     }
