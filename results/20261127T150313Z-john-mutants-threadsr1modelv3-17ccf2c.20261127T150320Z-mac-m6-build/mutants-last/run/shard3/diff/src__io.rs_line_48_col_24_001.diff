 /// bytes read, and the error if it failed.
 fn fill(reader: &mut impl io::Read, buffer: &mut [u8]) -> (usize, io::Result<()>) {
     let mut filled = 0;
     while filled < buffer.len() {
         match reader.read(&mut buffer[filled..]) {
             Ok(0) => break,
             Ok(n) => {
                 assert!(n <= buffer.len() - filled, "Read returned {n} bytes for a {}-byte slice", buffer.len() - filled);
-                filled += n;
+                filled *= /* ~ changed by cargo-mutants ~ */ n;
             }
             // see test_update_reader_interrupted
             Err(e) if e.kind() == io::ErrorKind::Interrupted => continue,
             Err(e) => return (filled, Err(e)),
         }
     }
     (filled, Ok(()))
 }
