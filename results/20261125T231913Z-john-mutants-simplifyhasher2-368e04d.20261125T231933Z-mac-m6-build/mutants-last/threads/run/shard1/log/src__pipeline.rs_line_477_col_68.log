                 let st_ref = unsafe { &*st };
                 assert!(!st_ref.retired.swap(true, Ordering::AcqRel), "PipeStorage double free");
                 LIVE_STORAGES.fetch_sub(1, Ordering::Relaxed);
             }
             crate::pipeline_sync::retire_storage!(st);
