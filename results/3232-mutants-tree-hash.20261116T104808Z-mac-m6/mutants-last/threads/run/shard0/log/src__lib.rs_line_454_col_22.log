             return hash_many(mode, batch, out);
         }
         // The whole batch as a part: its length is checked against the
         // digests there, on the caller's thread.
         crate::lanes::hash_many_in(mode, batch.part(0..batch.bytes().len() / batch.slot()), out);
     }
 
