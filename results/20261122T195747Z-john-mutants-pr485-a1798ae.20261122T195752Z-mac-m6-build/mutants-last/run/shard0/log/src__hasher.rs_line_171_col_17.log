     /// folds them together using 6 KiB of stack scratch (4 KiB + 2 KiB),
     /// rather than calling `get` row by row.
     pub fn rows_values<P: Parent>(&self, p: &P) -> [Cv; ROWS] {
         let mut values = [[0u8; 32]; ROWS];
