         return false;
     }
     crate::ffi_output::held_groups(hashers, held, platform);
     #[cfg(test)]
     let _ = HELD_GROUPS.try_with(|groups| groups.borrow_mut().push(held.to_vec()));
     crate::counted(crate::Counted::HeldPass);
     true
 }


