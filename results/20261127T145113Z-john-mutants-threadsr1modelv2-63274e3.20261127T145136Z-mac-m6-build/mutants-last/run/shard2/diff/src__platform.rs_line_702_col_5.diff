 /// The display family of CPUID leaf 1's EAX: the base family, plus the
 /// extended family where the base is 0xF.
 #[cfg(target_arch = "x86_64")]
 const fn family(eax: u32) -> u32 {
     let base = (eax >> 8) & 0xF;
     if base == 0xF { base + ((eax >> 20) & 0xFF) } else { base }
