 /// Whether hash_many_on takes messages of `len` bytes side by side on
 /// SME2: 2 to 15 chunks.
 #[inline(always)]
 fn chunked(len: usize) -> bool {
     cfg!(target_arch = "aarch64") && (CHUNK_LEN + 1..=15 * CHUNK_LEN).contains(&len)
 }
