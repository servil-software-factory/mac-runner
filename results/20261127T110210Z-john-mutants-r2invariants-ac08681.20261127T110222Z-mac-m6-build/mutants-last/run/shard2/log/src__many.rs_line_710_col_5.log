 #[cfg(target_arch = "aarch64")]
 #[inline(never)]
 fn hash_blocks(messages: &[u8], blocks: usize, key: &CVWords, flags: u8, outputs: &mut [[u8; OUT_LEN]], platform: Platform, last_len: usize) {
