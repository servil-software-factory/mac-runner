 /// a wake at every gap); 20 us cost 22% more CPU time a run for no speed;
 /// a cap on how many workers spin did not help.
 const SPIN: std::time::Duration = std::time::Duration::from_micros(5);
 
 /// Look for work for up to SPIN: whether some appeared. Holds one
 /// [`crate::registry::ReaderGuard`] across each 16-poll batch, dropping it
 /// between batches so any concurrent `unregister_and_drain` completes promptly.
 fn spin_for_work(token: &mut crate::registry::ReaderToken<'_>) -> bool {
-    let started = now();
-    loop {
-        let guard = token.enter();
-        for _ in 0..16 {
-            noted(Noted::Poll);
-            if sources::visible(&guard, false) {
-                return true;
-            }
-            core::hint::spin_loop();
-        }
-        drop(guard);
-        if spin_ends(now() - started, sources::open) {
-            return false;
-        }
-    }
+    true /* ~ changed by cargo-mutants ~ */
 }
 
 /// Whether a worker's look for work ends, `elapsed` into it: once SPIN has
 /// passed, or when no stream is open (asked only before SPIN, as the
 /// look's own code would). Its own function so a test holds it
 /// whatever the machine's load (#202: with `>=` turned to `<`, a worker
 /// preempted past SPIN before its first look spun while the stream stayed
 /// open, and the mutant timed out only under load).


