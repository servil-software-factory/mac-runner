 /// a filled stage is held and the rest of the piece waits.
 fn gather<'a>(
     hashers: &mut [Hasher],
     i: usize,
     bytes: &'a [u8],
     held: &mut crate::stack_vec::StackVec<usize, TABLE>,
     waiting: &mut crate::stack_vec::StackVec<(usize, &'a [u8]), TABLE>,
